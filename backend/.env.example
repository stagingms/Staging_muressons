# ══════════════════════════════════════════════════════════════════
# Muressons — Environment Variable Template
# Copy this file to .env and fill in your values.
# .env is git-ignored. Never store real credentials here.
# ══════════════════════════════════════════════════════════════════

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/muressons

# Leave blank to disable the master-password bypass (recommended)
MASTER_PASSWORD=

# Voice AI — get key from https://elevenlabs.io
ELEVENLABS_API_KEY=

# LLM scoring — get key from https://platform.openai.com
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000

# Set to false in production
DEBUG=false
