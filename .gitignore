backend/data/materiality_bu_*.json

# Local DB/state
backend/*.db
db/*.json
# SEED data is CONFIG, not state — it must be tracked or it never reaches the
# deployed image. BUG-2026-07-19: only seed_round1.json was re-included, so
# db/seed_healthcare.json had never been committed and a healthcare-paradigm
# cohort would fail to seed in production while working perfectly in local dev
# (database.py:120 picks it by filename). Every seed file needs a line here.
!db/seed_round1.json
!db/seed_healthcare.json
!db/facilitator_registry.json
sessions.json


# Live runtime state (written by the app; do not track)
# RES-1: in-memory snapshot rolling backup + quarantined corrupt files
db/*.bak
db/*.tmp
db/*.corrupt-*
sessions.json
db/admin_audit.jsonl
# F06(b): memory-store commit-results journal (runtime state, never committed)
db/commit_results.jsonl
backend/db/muressons_state.db

# Phase 5 calibration sweep data — the evidence behind
# docs/verification/phase5_recalibration.md. Regenerated by
# `python3 tests/calibration_sweep.py sweep`; ~4 MB, not source.
backend/tests/.calibration_sweep.jsonl

# Master-password override (bcrypt hash, set from God Mode)
backend/db/master_password.json

# Auto-generated JWT signing secret (auth_jwt.py) — NEVER commit
db/jwt_secret.key
backend/db/jwt_secret.key
jwt_secret.key

# Local archive — not for GitHub
archive/

# Setup notes with inlined secrets — local only, never commit
SETUP_STEPS.md

# Large video assets — keep out of git (141MB); use LFS/external storage if needed
videos/

# Claude session scratch — working files, never source
Claude outputs/

# FUSE mount artefacts, created when this folder is mounted into a remote
# session. Not files anyone wrote; they reappear and must never be committed.
.fuse_hidden*

# Documentation folder — 147MB of .docx/.pptx/screenshots plus two manual backup
# trees. Kept locally, excluded so pushes stay light. Untracked 2026-07-18.
#
# EXCEPTION (2026-09-08): the verification records and the figure-generation
# source are TEXT, together under 1MB, and backend code cites the records by
# path — rules.py and seven test modules name docs/verification/*.md, so a clone
# without them has code pointing at documents that do not exist. Note the
# `docs/*` form: git cannot re-include a file whose parent DIRECTORY is
# excluded, so a bare `docs/` would make every negation below silently inert.
docs/*
!docs/verification/
docs/verification/*
!docs/verification/*.md
!docs/figures/
docs/figures/*
!docs/figures/src/
docs/figures/src/*
!docs/figures/src/*.py

# frontend/docs was never meant to be excluded. The rule above used to read a
# bare `docs/`, which git matches at ANY depth, so a pattern written for the
# 147MB manuscript folder was also hiding three accessibility records here —
# including a VPAT draft. The `docs/*` form is root-anchored and does not.

# Scratch/staging dirs for pending deletions — never commit
_to_delete/

# W4.3 telemetry output — contains team names, never committed
COHORT_TELEMETRY_LATEST.md
