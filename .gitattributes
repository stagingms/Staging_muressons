# W5 hygiene (2026-09-01): the index is already uniformly LF; this locks it in
# so editor round-trips can never reintroduce CRLF (which broke exact-match
# patch anchors during the 2026-08 audit cycle).
* text=auto
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
# binary formats
*.png binary
*.jpg binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
