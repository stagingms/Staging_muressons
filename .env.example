# Muressons Global Command — Environment Configuration TEMPLATE
# Copy this file to .env and fill in real values. Never commit a real .env.

# ── Runtime mode ──────────────────────────────────────────────
# DEBUG=true  → local development (verbose, in-memory DB allowed, docs UI on)
# DEBUG=false → production (durable DB + JWT_SECRET required; see SEC-2/SEC-6)
DEBUG=false

# ── Database ──────────────────────────────────────────────────
# Production: use PostgreSQL.
USE_MEMORY_DB=false
DATABASE_URL=postgresql://muressons:CHANGE_ME@localhost:5432/muressons
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10
# Intentional single-laptop/offline run on the (non-durable) in-memory store:
#   set USE_MEMORY_DB=true and ALLOW_MEMORY_DB_IN_PROD=true (data is NOT durable).
# ALLOW_MEMORY_DB_IN_PROD=false

# ── Auth (SEC-1 / SEC-6) ──────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=
# Session length in hours (use 8+ for full-day workshops).
JWT_EXPIRY_HOURS=8

# ── Break-glass (SEC-4) — leave EMPTY normally ────────────────
# When set, overrides every player/facilitator login. Enable only for a
# recovery window, then unset. All uses are recorded in db/admin_audit.jsonl.
MASTER_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allowlist of frontend origins.
CORS_ORIGINS=https://your-domain.example
