# Muressons Global Command — Environment Configuration TEMPLATE
# Copy this file to .env and fill in real values. Never commit a real .env.

# ── Runtime mode ──────────────────────────────────────────────
# DEBUG=true  → local development (verbose, in-memory DB allowed, docs UI on)
# DEBUG=false → production (durable DB + JWT_SECRET required; see SEC-2/SEC-6)
DEBUG=false

# ── Database ──────────────────────────────────────────────────
# Production: use PostgreSQL.
USE_MEMORY_DB=false
DATABASE_URL=postgresql://muressons:CHANGE_ME@localhost:5432/muressons
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10
# Intentional single-laptop/offline run on the (non-durable) in-memory store:
#   set USE_MEMORY_DB=true and ALLOW_MEMORY_DB_IN_PROD=true (data is NOT durable).
# ALLOW_MEMORY_DB_IN_PROD=false

# ── Auth (SEC-1 / SEC-6) ──────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=
# Session length in hours (use 8+ for full-day workshops).
JWT_EXPIRY_HOURS=8

# ── Cookie transport security (SEC-2) ─────────────────────────
# The session cookie's Secure flag is now decoupled from DEBUG.
#   • Unset (default) → Secure is ON whenever DEBUG=false.
#   • COOKIE_SECURE=true  → force Secure (recommended; requires HTTPS).
#   • COOKIE_SECURE=false → allow the cookie over plaintext HTTP.
# In production (DEBUG=false) the server REFUSES to boot with insecure cookies
# unless you also set ALLOW_INSECURE_COOKIES=true (intentional HTTP-only LAN
# workshop only — session tokens become sniffable).
# COOKIE_SECURE=true
# ALLOW_INSECURE_COOKIES=false

# ── Break-glass (SEC-4) — leave EMPTY normally ────────────────
# Admin break-glass: overrides god_mode + any FACILITATOR login. Enable only for
# a recovery window, then unset. All uses are recorded in db/admin_audit.jsonl.
# P6: this NO LONGER unlocks player accounts — that uses the separate secret below.
MASTER_PASSWORD=

# P6 — Player master-unlock, SEPARATE from MASTER_PASSWORD so one leak can't span
# both realms. Lets support staff log into any player account. Leave EMPTY to keep
# player master-unlock DISABLED (recommended). If you enable it, use a value
# DISTINCT from MASTER_PASSWORD. It does NOT fall back to MASTER_PASSWORD.
PLAYER_MASTER_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allowlist of frontend origins.
CORS_ORIGINS=https://your-domain.example

# ── Scale-out (audit #7/#8) ───────────────────────────────────
# Number of backend web workers. scale_preflight CLAMPS this to 1 unless the
# shared Postgres backend is active (USE_MEMORY_DB=false, ALLOW_MEMORY_DB_IN_PROD
# unset, DEBUG=false) — per-process state (sessions, pacing, freeze, rate limits)
# cannot be split across workers on the in-memory store. For the ~500-user
# target run Postgres and set this to (2 x vCPU)+1, then add Railway replicas.
# WEB_CONCURRENCY=5
#
# How often each worker pulls shared coordination state (pacing/freeze) from
# Postgres, i.e. the cross-worker propagation window in seconds (default 3).
# COORDINATION_REFRESH_SECONDS=3
