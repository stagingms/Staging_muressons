# ═══════════════════════════════════════════════════════════════════════════
#  Muressons — Railway deployment variables
#
#  Copy these into Railway → your service → Variables. Do NOT commit real
#  secrets to this file; it is a template and it IS in git.
#
#  The backend runs a preflight at boot and prints a warning block for the
#  misconfigurations that used to surface hours later as unexplained login
#  failures. A clean boot prints:
#      [preflight] Deployment configuration looks correct.
# ═══════════════════════════════════════════════════════════════════════════

# ── Storage ────────────────────────────────────────────────────────────────
# false => PostgreSQL. main.py REFUSES to boot on the in-memory store when
# DEBUG=false, so a mistake here fails loudly rather than losing a workshop.
USE_MEMORY_DB=false

# Railway sets this automatically when you add the Postgres plugin. Only set
# it by hand if you are pointing at an external database.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Durable path for mutable state: facilitator registry, token revocations,
# audit log, rate-limit bans, and the master-password override.
# REQUIRES a Railway VOLUME actually mounted at this path — without one it is
# just another ephemeral directory and every redeploy wipes your facilitators.
# Mount it at its own path. Do NOT mount over /app/db: that would hide the
# seed files that ship in the image.
MURESSONS_DATA_DIR=/data

# ── Auth ───────────────────────────────────────────────────────────────────
# MANDATORY in production — main.py exits at startup if DEBUG=false and this
# is unset. Generate with:  openssl rand -hex 32
# Changing it invalidates every live session, so rotate only between workshops.
JWT_SECRET=

# Default is 2h. A workshop that runs longer will log facilitators out
# mid-session, so set this to cover the whole event.
JWT_EXPIRY_HOURS=8

# ── Break-glass credentials ────────────────────────────────────────────────
# god_mode login. Generate with:  openssl rand -base64 24
# Unset => the god_mode bypass is DISABLED, which is the safest posture if you
# have a real super_admin account in the registry.
#
# NOTE: a master password rotated from inside the app writes
# <MURESSONS_DATA_DIR>/master_password.json, and that file WINS over this
# variable. The preflight warns when both exist.
MASTER_PASSWORD=

# project_admin login — provisioning only (creates facilitators and cohorts,
# never manages a live run). Read straight from the environment; no override
# layer, so this value always applies.
PROJECT_ADMIN_PASSWORD=

# ── DELIBERATELY UNSET IN PRODUCTION ───────────────────────────────────────
# PLAYER_MASTER_PASSWORD is a skeleton key to ANY student account. Set it only
# during a recovery window, then remove it. The preflight flags it if present.
# PLAYER_MASTER_PASSWORD=
#
# DEBUG defaults to false. Leaving it unset is what makes session cookies
# Secure and suppresses the emergency-credential console print.
# DEBUG=false

# ── Network ────────────────────────────────────────────────────────────────
# Comma-separated, no trailing slash. Railway's own public domain is appended
# automatically from RAILWAY_PUBLIC_DOMAIN, so this is often unnecessary — set
# it when the frontend is served from a different origin.
# CORS_ORIGINS=https://your-app.up.railway.app

# Which source addresses are allowed to set X-Forwarded-For. Behind a platform
# edge proxy the direct connection comes from an INTERNAL address, so leaving
# this at the localhost default means the header is ignored and every client
# collapses into one rate-limit bucket — one student mistyping a password can
# then 429 the entire cohort.
#
# CIDR ranges are supported. Trusting a PRIVATE range is safe: a client cannot
# choose the source address of the connection the platform makes to your
# container. Never add a public range you do not control.
TRUSTED_PROXY_IPS=127.0.0.1,::1,10.0.0.0/8,100.64.0.0/10
